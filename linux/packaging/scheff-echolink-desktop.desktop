# SPDX-License-Identifier: GPL-3.0-or-later
# The desktop session's menu entry: opens Scheff EchoLink in a window.
# Installed to /usr/share/scheff-echolink/; the app copies it to
# ~/.local/share/applications at each start. TryExec hides it once the
# package is removed.
[Desktop Entry]
Name=Scheff EchoLink
Comment=EchoLink client for amateur radio
TryExec=/usr/share/APPLaunch/bin/scheff-echolink
Exec=/usr/share/APPLaunch/bin/scheff-echolink
Icon=/usr/share/scheff-echolink/scheff-echolink.png
Terminal=false
Type=Application
Categories=Network;AudioVideo;HamRadio;
StartupWMClass=scheff-echolink
